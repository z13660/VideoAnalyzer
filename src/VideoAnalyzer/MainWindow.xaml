<Window x:Class="VideoAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:VideoAnalyzer.Controls"
        xmlns:conv="clr-namespace:VideoAnalyzer.Converters"
        Title="VideoAnalyzer — frame level stream analyser"
        Icon="pack://application:,,,/app.ico"
        Height="820" Width="1320" MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBack}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <conv:AccentWhenTrueConverter x:Key="AccentWhenTrue" />
        <conv:OverlayAccentConverter x:Key="OverlayAccent" />
        <conv:OverlayIconConverter x:Key="OverlayIcon" />
    </Window.Resources>

    <Grid x:Name="Root" Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== toolbar ============================== -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="{StaticResource RailBack}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
            <!-- Two columns so the clusters can never overlap. The left one is a WrapPanel:
                 on a narrow window it drops to a second row instead of colliding with the
                 mode switches on the right. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="打开视频" Click="OnOpenClick" />
                    <Button Style="{StaticResource ToolButton}" Content="重新分析" Click="OnReanalyseClick" />
                    <Button Style="{StaticResource ToolButton}" Content="取消分析" Click="OnCancelAnalysisClick"
                            ToolTip="停止剩余的分析，保留已经算出的结果"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ToolButton}" Content="分析范围…" Click="OnAnalyseRangeClick"
                            ToolTip="选择要分析的时间段，只对它重跑 QP 与运动分析，其余结果保留"
                            Visibility="{Binding IsBusy, Converter={StaticResource NotBoolToVis}}" />

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Transport: jump to an end, step a frame, play. -->
                    <Button Style="{StaticResource TransportButton}" Click="OnGoToStartClick"
                            ToolTip="回到开头 (Home)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoStart}" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OnPrevKeyFrameClick"
                            ToolTip="上一关键帧 (Ctrl+←)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoKeyPrev}" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OnStepBackClick"
                            ToolTip="上一帧 (←)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoStepBack}" />
                    </Button>

                    <!-- play / pause: two buttons, one visible at a time -->
                    <Grid Margin="2,0,2,0">
                        <Button Style="{StaticResource TransportPlayButton}" Click="OnPlayPauseClick"
                                ToolTip="播放 (空格)"
                                Visibility="{Binding IsPlaying, Converter={StaticResource NotBoolToVis}}">
                            <Path Style="{StaticResource TransportIconAccent}" Data="{StaticResource IcoPlay}" />
                        </Button>
                        <Button Style="{StaticResource TransportPlayButton}" Click="OnPlayPauseClick"
                                ToolTip="暂停 (空格)"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                            <Path Style="{StaticResource TransportIconAccent}" Data="{StaticResource IcoPause}" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource TransportButton}" Click="OnStepForwardClick"
                            ToolTip="下一帧 (→)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoStepFwd}" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OnNextKeyFrameClick"
                            ToolTip="下一关键帧 (Ctrl+→)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoKeyNext}" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OnGoToEndClick"
                            ToolTip="到结尾 (End)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoEnd}" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="OnToggleLoopClick"
                            ToolTip="循环播放 (Ctrl+L)">
                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IcoLoop}"
                              Stroke="{Binding Loop, Converter={StaticResource AccentWhenTrue}}" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Sequence zoom, Premiere style: - slider + fit -->
                    <Button Style="{StaticResource TransportButton}" Content="&#x2212;" FontSize="14"
                            Click="OnZoomOutClick" ToolTip="缩小时间轴" Foreground="#C6D2E2" />
                    <Slider Style="{StaticResource ZoomSlider}" Value="{Binding ZoomLevel}"
                            ToolTip="时间轴缩放" />
                    <Button Style="{StaticResource TransportButton}" Content="+" FontSize="14"
                            Click="OnZoomInClick" ToolTip="放大时间轴" Foreground="#C6D2E2" />
                    <Button Style="{StaticResource TransportButton}" Click="OnResetZoomClick"
                            ToolTip="适应窗口 (Ctrl+0)">
                        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource IcoFit}" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- audio: mute toggle + level -->
                    <Button Style="{StaticResource TransportButton}" Click="OnToggleMuteClick"
                            IsEnabled="{Binding HasAudio}" ToolTip="静音 (Ctrl+M)">
                        <!-- The glyph states which way the button will act: sound waves while
                             the clip is audible, a cross once it is muted. A single crossed
                             speaker left the icon contradicting the level read-out next to it. -->
                        <Grid>
                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IcoVolume}"
                                  Stroke="{Binding Muted, Converter={StaticResource AccentWhenTrue}}"
                                  Visibility="{Binding Muted, Converter={StaticResource NotBoolToVis}}" />
                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IcoMute}"
                                  Stroke="{Binding Muted, Converter={StaticResource AccentWhenTrue}}"
                                  Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Slider Style="{StaticResource VolumeSlider}" Value="{Binding Volume}"
                            IsEnabled="{Binding HasAudio}" ToolTip="{Binding AudioHint}" />
                    <TextBlock Style="{StaticResource MonoText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               MinWidth="34" Margin="2,0,6,0" Text="{Binding VolumeText}" />
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource ToggleButton}" Click="OnCycleOverlayClick"
                            ToolTip="{Binding OverlayLabel}">
                        <Path Style="{StaticResource StrokeIcon}"
                              Data="{Binding Overlay, Converter={StaticResource OverlayIcon}}"
                              Stroke="{Binding Overlay, Converter={StaticResource OverlayAccent}}" />
                    </Button>
                    <Button Style="{StaticResource ToggleButton}" Click="OnTogglePinClick"
                            ToolTip="固定播放头：播放头钉在视图中央">
                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IcoPin}"
                              Stroke="{Binding PinPlayhead, Converter={StaticResource AccentWhenTrue}}" />
                    </Button>
                    <Button Style="{StaticResource ToggleButton}" Click="OnToggleMotionClick"
                            ToolTip="运动分析（耗时阶段）">
                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IcoMotion}"
                              Stroke="{Binding MotionAnalysisEnabled, Converter={StaticResource AccentWhenTrue}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================= video + info panel ======================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VideoColumn" Width="0.96*" MinWidth="300" />
                <ColumnDefinition x:Name="InfoColumn" Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border x:Name="VideoFrame" Grid.Column="0" Background="#000000"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,8,0" ClipToBounds="True">
                <ctrl:VideoSurface x:Name="Surface"
                                   MouseLeftButtonDown="OnSurfaceMouseDown"
                                   Media="{Binding Media}"
                                   FrameInfo="{Binding CurrentFrame}"
                                   Overlay="{Binding Overlay}" />
            </Border>

            <Border x:Name="InfoPanel" Grid.Column="1" Background="{StaticResource PanelBack}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Rectangle Style="{StaticResource SectionTick}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SOURCE" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MediaRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource InfoValue}"
                                                   Foreground="{Binding ValueBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,7" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Rectangle Style="{StaticResource SectionTick}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="CURRENT FRAME" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FrameRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource InfoLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource InfoValue}"
                                                   Foreground="{Binding ValueBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,7" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Rectangle Style="{StaticResource SectionTick}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding TypeSummary}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TypeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="9" Height="9" RadiusX="2" RadiusY="2"
                                                   VerticalAlignment="Center" Fill="{Binding Swatch}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Letter}" Style="{StaticResource MonoText}"
                                                   FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource MonoText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource LabelBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource MonoText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding BytePercentText}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource LabelBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================ graph stack ============================ -->
        <Border x:Name="GraphPanel" Grid.Row="2" Background="#0B0E13"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Margin="0,6,0,0" ClipToBounds="True">
            <Grid x:Name="GraphStack">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <ctrl:FrameGraph Grid.Row="0" Kind="Bitrate" Title="BITRATE   kbps per frame"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
                <Border Grid.Row="1" Background="{StaticResource DottedDivider}" />
                <ctrl:FrameGraph Grid.Row="2" Kind="FrameType" Title="FRAME TYPE"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
                <Border Grid.Row="3" Background="{StaticResource DottedDivider}" />
                <ctrl:FrameGraph Grid.Row="4" Kind="Qp" Title="QP   avg (line) / min-max (band)"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
                <Border Grid.Row="5" Background="{StaticResource DottedDivider}" />
                <ctrl:FrameGraph Grid.Row="6" Kind="Motion" Title="MOTION   mean vector length (fwd / bwd share)"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
                <Border Grid.Row="7" Background="{StaticResource DottedDivider}" />
                <ctrl:FrameGraph Grid.Row="8" Kind="Gop" Title="GOP   frames since keyframe"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
                <Border Grid.Row="9" Background="{StaticResource DottedDivider}" />
                <ctrl:FrameGraph Grid.Row="10" Kind="Reorder" Title="REORDER   pts-dts in frames / flags"
                                 Result="{Binding Result}" Position="{Binding Position}"
                                 ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                 PinPlayhead="{Binding PinPlayhead}"
                                 AnalysedRuns="{Binding AnalysedRuns}"
                                 ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                 ZoomRequested="OnZoomRequested" />
            </Grid>
        </Border>

        <!-- ============================== timeline =============================
             The spacer on the right is the same width as the graphs' axis column, so the
             timeline and the graphs share one time-to-x mapping. Without it the two strips
             have different widths and a click lands on a different time than the graph above
             the cursor shows. -->
        <Grid x:Name="TimelinePanel" Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="74" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B0E13"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
                <ctrl:TimelineStrip Height="30"
                                    RangeRequested="OnTimelineRangeRequested"
                                    Position="{Binding Position}"
                                    ViewStart="{Binding ViewStart}" ViewEnd="{Binding ViewEnd}"
                                    PinPlayhead="{Binding PinPlayhead}"
                                    AnalysedRuns="{Binding AnalysedRuns}"
                                    RangeAnchor="{Binding RangeAnchor}"
                                    ClipSeconds="{Binding TotalSeconds}"
                                    ScrubPreview="OnScrubPreview" ScrubCommit="OnScrubCommit"
                                    ZoomRequested="OnZoomRequested" />
            </Border>
        </Grid>

        <!-- ============================= status bar ============================ -->
        <Grid x:Name="StatusBar" Grid.Row="4" Margin="2,6,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <!-- the zoom read-out lives here rather than beside the timeline: a badge in that
                 row would narrow the strip and break its alignment with the graphs -->
            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" FontSize="10.5"
                       Margin="0,0,16,0" VerticalAlignment="Center"
                       Foreground="{StaticResource LabelBrush}" Text="{Binding ZoomText}" />
            <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="10.5"
                       Margin="0,0,14,0" VerticalAlignment="Center"
                       Foreground="#5C6675" Text="{Binding FfmpegText}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,10,0" Text="{Binding ProgressStage}" />
                <ProgressBar Style="{StaticResource ThinProgress}" Width="220" Maximum="1"
                             Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
