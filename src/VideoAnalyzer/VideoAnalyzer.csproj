<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>VideoAnalyzer</AssemblyName>
    <RootNamespace>VideoAnalyzer</RootNamespace>
    <Version>1.0.1</Version>
    <Product>VideoAnalyzer</Product>
    <Description>Frame-accurate video stream analyzer (QCTools style) built on ffmpeg.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <!-- the same artwork as a resource, so the window can use it for its title bar -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Ship the bundled ffmpeg build next to the executable when it is present, so a
    published copy is self contained. `dotnet build` stays fast because the 300 MB of
    binaries only travel on publish.
  -->
  <!--
    Ship the bundled ffmpeg build next to the executable when it is present, so a published
    copy can be unpacked and run. The item type matters: CopyToOutputDirectory and
    CopyToPublishDirectory are only honoured on the types the SDK copies, so a custom name
    like <FfmpegPayload> is silently ignored — which is how an earlier release came out at
    450 KB with no ffmpeg in it.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\bin\ffmpeg.exe')">
    <None Include="$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\bin\ffmpeg.exe;
                   $(MSBuildProjectDirectory)\..\..\tools\ffmpeg\bin\ffprobe.exe">
      <Link>tools\ffmpeg\bin\%(Filename)%(Extension)</Link>
      <!-- Publish only: copying 200 MB into bin/ on every ordinary build would make the edit
           and build loop unusable, and nothing needs the toolchain beside a debug binary. -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
